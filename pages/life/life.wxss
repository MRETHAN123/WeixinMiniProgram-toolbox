page {
  background-color: #f7f8fa;
}

.container {
  padding: 40rpx 30rpx;
}

.header {
  margin-bottom: 30rpx;
  padding-left: 10rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.subtitle {
  font-size: 28rpx;
  color: #888;
}

/* === 轮播图样式 === */
.swiper-box {
  margin-bottom: 50rpx;
  border-radius: 24rpx;
  overflow: hidden; /* 裁剪圆角 */
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.15); /* 加深一点阴影 */
  position: relative;
  transform: translateZ(0); /* 修复部分机型圆角失效问题 */
}

swiper {
  height: 360rpx; /* 稍微调高一点，视觉冲击力更强 */
}

.swiper-item-wrap {
  width: 100%;
  height: 100%;
  position: relative;
}

.slide-image {
  width: 100%;
  height: 100%;
}

/* 文字遮罩层：底部渐变黑 */
/* ... 其他样式不变 ... */

.slide-text {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  /* 修改这里：上40，左右30，下60 (给圆点留位置) */
  padding: 40rpx 30rpx 60rpx; 
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  /* 加深一点渐变，防止背景图太亮看不清字 */
  background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 100%);
  box-sizing: border-box;
}
/* ================= */

/* 卡片通用样式 */
.nav-card {
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.1s;
  color: #fff;
  height: 160rpx;
}

.nav-card:active {
  transform: scale(0.98);
}

/* 1. 待办卡片 - 蓝色渐变 */
.todo-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

/* 2. 日记卡片 - 橙粉渐变 */
.diary-card {
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 99%, #fecfef 100%);
}

.diary-card .card-title, 
.diary-card .card-desc, 
.diary-card .card-icon {
  color: #fff; 
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.card-content {
  flex: 1;
}

.card-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.card-icon {
  font-size: 80rpx;
  opacity: 0.8;
}