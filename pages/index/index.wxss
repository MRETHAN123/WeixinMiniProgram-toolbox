/* 页面容器 */
.container {
  padding: 30rpx;
}

/* 顶部欢迎区 */
.header {
  margin-bottom: 30rpx;
  padding-left: 10rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.subtitle {
  font-size: 28rpx;
  color: #888;
}

/* === 轮播图样式 === */
.swiper-box {
  margin-bottom: 40rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
}

swiper {
  height: 280rpx; /* 高度适中 */
}

.swiper-item-wrap {
  width: 100%;
  height: 100%;
  position: relative;
}

.slide-image {
  width: 100%;
  height: 100%;
}

/* ... 其他样式不变 ... */

.slide-text {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  /* 修改这里：上20，左右24，下60 (给圆点留位置) */
  padding: 20rpx 24rpx 60rpx; 
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  /* 调整渐变背景的高度，让文字更清晰 */
  background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 100%);
}
/* ================= */

/* 九宫格卡片容器 */
.grid-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx 10rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-wrap: wrap; 
}

/* 单个宫格 */
.grid-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

/* 图标背景圈 */
.icon-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.emoji {
  font-size: 48rpx;
}

/* 文字标签 */
.label {
  font-size: 26rpx;
  color: #555;
}