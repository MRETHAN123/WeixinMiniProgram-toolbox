<view class="container">
  <!-- 1. 输入区域卡片 -->
  <view class="card input-card">
    <view class="title">身体数据录入</view>
    
    <view class="input-group">
      <text class="label">身高 (cm)</text>
      <input class="input" type="digit" placeholder="请输入身高" bindinput="onHeightInput" />
    </view>
    
    <view class="input-group">
      <text class="label">体重 (kg)</text>
      <input class="input" type="digit" placeholder="请输入体重" bindinput="onWeightInput" />
    </view>

    <button class="btn-calc" bindtap="calculateBMI">开始计算</button>
  </view>

  <!-- 2. 结果展示区域 (只有当 bmi 有值时才显示) -->
  <view class="card result-card" wx:if="{{bmi}}">
    <view class="result-title">您的 BMI 指数</view>
    <view class="bmi-value">{{bmi}}</view>
    
    <!-- 动态改变颜色：偏瘦是黄，正常是绿，偏胖是红 -->
    <view class="bmi-tag {{statusClass}}">
      {{status}}
    </view>
    
    <view class="suggestion">
      <text>💡 健康建议：</text>
      <text>{{suggestion}}</text>
    </view>
  </view>
</view>