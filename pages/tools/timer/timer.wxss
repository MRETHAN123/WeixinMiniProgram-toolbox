/* 1. 页面整体布局 */
page {
  background-color: #f7f8fa;
  height: 100%;
}

.container {
  padding: 30rpx;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center; /* 居中对齐 */
}

/* 2. 顶部 Tab 切换栏 */
.tab-header {
  display: flex;
  width: 100%;
  background: #e0e0e0;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 80rpx; /* 距离下方内容的间距 */
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.3s; /* 增加一点过渡动画 */
}

.tab-item.active {
  background: #fff;
  color: #1989fa;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

/* 3. 计时器主体区域 */
.timer-box {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 4. 数字大屏显示 */
.clock-display {
  font-size: 90rpx; /* 超大字体 */
  font-weight: bold;
  color: #333;
  font-family: 'Courier New', Courier, monospace; /* 等宽字体，防止数字跳动 */
  margin-bottom: 80rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.colon {
  margin: 0 10rpx;
  color: #ccc;
  font-size: 70rpx;
  transform: translateY(-10rpx);
}

.millisecond {
  font-size: 50rpx;
  color: #1989fa;
  margin-left: 10rpx;
}

/* 5. 倒计时输入框区域 (新) */
.input-container {
  display: flex;
  justify-content: center;
  margin-bottom: 80rpx;
}

.time-input-group {
  display: flex;
  align-items: flex-end;
  margin: 0 15rpx;
}

.time-input {
  width: 110rpx;
  height: 110rpx;
  background: #fff;
  border-bottom: 6rpx solid #1989fa; /* 底部粗蓝线 */
  text-align: center;
  font-size: 56rpx;
  font-weight: bold;
  color: #333;
  border-radius: 8rpx 8rpx 0 0;
}

.time-label {
  font-size: 30rpx;
  color: #666;
  margin-left: 10rpx;
  margin-bottom: 14rpx;
}

/* 6. 按钮区域 */
.btn-area {
  display: flex;
  width: 100%;
  justify-content: space-around; /* 按钮分散对齐 */
  margin-top: 20rpx;
}

/* 圆形按钮样式 */
.btn {
  width: 160rpx !important; /* 强制覆盖微信默认样式 */
  height: 160rpx;
  border-radius: 50%;      /* 变成正圆形 */
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #fff;
  padding: 0;
  margin: 0;
  box-shadow: 0 6rpx 12rpx rgba(0,0,0,0.2); /* 按钮阴影 */
}

.btn-reset {
  background-color: #909399; /* 灰色 */
}

.btn-start {
  background-color: #07c160; /* 绿色 */
}

.btn-stop {
  background-color: #ff4d4f; /* 红色 */
}

/* 倒计时结束闪烁动画 */
.blink {
  animation: blink-anim 1s infinite;
  color: #ff4d4f;
}

@keyframes blink-anim {
  0% { opacity: 1; }
  50% { opacity: 0.2; }
  100% { opacity: 1; }
}